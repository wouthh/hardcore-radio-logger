[Unit]
Description=Hardcore Radio 3-way music sync

[Service]
Type=oneshot
WorkingDirectory={{PROJECT_DIR}}
EnvironmentFile={{ENV_FILE}}
Environment=PYTHONUNBUFFERED=1
# Runs take seconds to a few minutes; a hung run must not block every later timer run.
TimeoutStartSec=30min
ExecStart="{{PYTHON_BIN}}" -m hcr_sync run-once --apply
